# ── ImpactBridge AI – Environment Example ──────────────────────────
# Copy this file to .env and adjust values as needed.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# Database (SQLite by default – zero configuration)
DATABASE_URL=sqlite:///impactbridge.db

# ── AI (Ollama – local, free, offline) ─────────────────────────────
# If Ollama is not running, the app automatically falls back to a
# built-in rule-based engine. The app never crashes when AI is offline.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Set to true to enable live Ollama answers (requires Ollama running).
# When false, the built-in rule-based fallback engine answers all queries.
OLLAMA_ENABLED=false

# ── Site ────────────────────────────────────────────────────────────
SITE_NAME=ImpactBridge AI
SITE_TAGLINE=Connecting People. Creating Impact.
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=16